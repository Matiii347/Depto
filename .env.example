# Puerto del Servidor Web
PORT=3000

# Conexión a Base de Datos PostgreSQL (para producción / Render / Railway)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_base_datos
DB_SSL=true

# Conexión Local (Alternativa a DATABASE_URL)
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=postgre
DB_NAME=Deptos
DB_PORT=5432

# Números de WhatsApp para Redirección Dinámica de Reservas
# Formato internacional sin símbolo '+' (Ej: 5548999999999 o 5493510000000)
WA_ADMIN_BR=5548999999999
WA_FAMILIA_AR=5493510000000

# Clave de Seguridad para Moderación Rápida de Reseñas por URL
MODERATION_SECRET=TuClaveSuperSeguraAqui2026
